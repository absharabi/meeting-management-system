# Server Setup
PORT=5000
FRONTEND_URL=http://localhost:3000

# Security Keys (you can make up any random text for these right now)
JWT_SECRET=my_super_secret_jwt_key_123
JWT_REFRESH_SECRET=my_super_secret_refresh_key_456

# Auto-Create an Admin Account (put your email here)
FIRST_SUPERADMIN_EMAIL=your.email@example.com

# Google Authentication (You need to get these from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# (Optional) Real Database Connection. If you leave this blank, 
# it will automatically start a temporary in-memory database for testing!
MONGO_URI=
